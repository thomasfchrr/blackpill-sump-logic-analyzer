{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: build",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/tools/build.ps1",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Firmware: build (debug)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/tools/build.ps1 -Debug",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Firmware: build + flash (ST-LINK)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/tools/flash.ps1 -Build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Host: tests + hardware self-test",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/tools/test.ps1",
      "problemMatcher": []
    },
    {
      "label": "Host: open viewer",
      "type": "shell",
      "command": "python -m blackpill_sump gui",
      "options": { "cwd": "${workspaceFolder}/host" },
      "problemMatcher": []
    }
  ]
}
