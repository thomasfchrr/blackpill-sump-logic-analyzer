{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BlackPill: launch (ST-LINK V3)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/firmware/build/blackpill_sump.elf",
      "device": "STM32F411CE",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Firmware: build (debug)"
    },
    {
      "name": "BlackPill: attach (ST-LINK V3)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/firmware/build/blackpill_sump.elf",
      "device": "STM32F411CE",
      "interface": "swd"
    }
  ]
}
